# 部署密钥模板：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略，不入库）
#   cp .env.example .env
# 生成方式：openssl rand -hex 32（APP_SECRET）/ openssl rand -hex 16（POSTGRES_PASSWORD）

# Umami 统计的签名密钥（必填）
UMAMI_APP_SECRET=please-generate-with-openssl-rand-hex-32
# Postgres 数据库密码（必填）
POSTGRES_PASSWORD=please-generate-with-openssl-rand-hex-16

# 站点对外 URL（部署初期证书未就绪用 http；HTTPS 就绪后改为 https://shaoyuanyu.cn）
SITE_URL=http://shaoyuanyu.cn

# 主人登录（TOTP）：运行 pnpm totp:setup 自动生成并写入（勿手写，勿提交）
TOTP_SECRET=
AUTH_SECRET=
RECOVERY_CODES=

# CalDAV（站主专属日历）：VPS 上运行 scripts/setup-calendar-vps.sh 创建账号后填入
# CALDAV_URL 生产为 compose 网络内 http://radicale:5232（本地测试用 http://127.0.0.1:5232）
CALDAV_URL=http://radicale:5232
CALDAV_USER=caladmin
CALDAV_PASSWORD=
