# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# playwright
/playwright-report/
/test-results/

# OG 图字体缓存（构建期下载，不入镜像）
/.og-fonts/

# next.js
/.next/
/out/

# production
/build
/dist

# 构建时生成的导航页站点图标（由 scripts/fetch-favicons.mjs 生成）
/public/favicons/

# CalDAV（Radicale）私有数据：用户文件与日历集合（VPS 生成，不入库）
/radicale/users
/radicale/collections/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# 主人私有数据（想法速记 data/ideas.json 等），仅存本地与 VPS，不入库
/data/

# AI 助手开发规范（开发规范/部署经验/踩坑记录），仅保留在本地，不入库
/CLAUDE.md

# vercel
.vercel

# typescript
*.tsbuildinfo

# velite content build output
/.velite/
next-env.d.ts

# 字体子集化源文件缓存（30MB+，不入库）
/.cache/
